{
  "name": "norwinapps",
  "version": "0.2.0",
  "description": "Hub / launcher for all NorwinLabs apps",
  "main": "main.js",
  "author": "NorwinLabs",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.norwinlabs.norwinapps",
    "productName": "NorwinApps",
    "files": [
      "main.js",
      "preload.js",
      "apps.json",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NorwinLabs",
        "repo": "NorwinAppsLauncher",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NorwinLabs/NorwinAppsLauncher.git"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
